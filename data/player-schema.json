{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Player",
  "description": "Estructura de un jugador estilo Transfermarkt + atributos de manager",
  "type": "object",
  "required": ["id", "name", "age", "positions", "clubId", "nationality", "marketValue", "overall", "potential"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "age": { "type": "integer", "minimum": 15, "maximum": 45 },
    "dateOfBirth": { "type": "string", "format": "date" },
    "nationality": { "type": "string" },
    "positions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Posiciones principales (GK, CB, LB, RB, DM, CM, AM, LW, RW, ST, etc.)"
    },
    "preferredFoot": { "type": "string", "enum": ["Left", "Right", "Both"] },
    "height": { "type": "integer", "description": "Altura en cm" },
    "clubId": { "type": "string" },
    "leagueId": { "type": "string" },
    "marketValue": { "type": "number", "description": "Valor en euros" },
    "wage": { "type": "number", "description": "Salario semanal aproximado" },
    "contractUntil": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["active", "loan", "loaned_out", "injured", "suspended", "youth"],
      "default": "active"
    },
    "loanFrom": { "type": ["string", "null"] },
    "loanTo": { "type": ["string", "null"] },
    "overall": { "type": "integer", "minimum": 1, "maximum": 99 },
    "potential": { "type": "integer", "minimum": 1, "maximum": 99 },
    "attributes": {
      "type": "object",
      "description": "Atributos opcionales más detallados",
      "properties": {
        "pace": { "type": "integer" },
        "shooting": { "type": "integer" },
        "passing": { "type": "integer" },
        "dribbling": { "type": "integer" },
        "defending": { "type": "integer" },
        "physical": { "type": "integer" }
      }
    },
    "notes": { "type": "string" }
  }
}